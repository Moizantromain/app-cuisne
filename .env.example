# Environnement de l'application
EXPO_PUBLIC_APP_ENV=development

# Supabase : à récupérer dans le panneau Connect du projet Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Facultatif : suivi des erreurs lorsque Sentry sera configuré
EXPO_PUBLIC_SENTRY_DSN=

# Ne jamais renseigner SUPABASE_SERVICE_ROLE_KEY dans ce fichier ou dans l'application mobile.
# Cette clé doit rester dans les secrets d'un serveur ou d'une Edge Function Supabase.
